ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./data/requests.db
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_REQUESTS=5
MAX_BODY_BYTES=12000
HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
NOTIFICATION_EMAIL=YOUR_GMAIL_ADDRESS
